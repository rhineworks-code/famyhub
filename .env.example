# ---------------------------------------------------------------
# FamyHub – Konfiguration. Kopieren nach ".env" und anpassen.
# ---------------------------------------------------------------

# Port, unter dem FamyHub auf dem Server erreichbar ist
FAMYHUB_PORT=3265

# Geheimer Schlüssel für die Anmeldung (mind. 32 Zeichen).
# Erzeugen mit:  openssl rand -hex 32
# Leer lassen = wird beim ersten Start automatisch erzeugt und in data/.jwt_secret gespeichert.
JWT_SECRET=

# Push-Benachrichtigungen (Web Push / VAPID).
# Erzeugen mit:  docker run --rm node:22-slim npx -y web-push generate-vapid-keys
# Bestehende Schlüssel aus der alten backend/.env hier übernehmen, dann bleiben die Geräte-Abos gültig.
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Jeder darf eine neue Familie registrieren? (Standard: nein – Mitglieder werden vom Admin angelegt
# oder treten mit dem Einladungscode bei.)
ALLOW_REGISTRATION=false

# Hinter einem Reverse Proxy (Nginx Proxy Manager, Traefik, Caddy …) auf true setzen.
TRUST_PROXY=false

# Anmeldedauer in Tagen (normal / "angemeldet bleiben")
SESSION_DAYS=7
REMEMBER_ME_DAYS=90

# Zeitzone für Erinnerungen, Aufgaben-Intervalle und Kalender-Export
TZ=Europe/Berlin

# Optional: Standort für das Wetter-Widget
# WEATHER_LAT=50.1109
# WEATHER_LON=8.6821

# Optional: Fallback-Mailserver für "Passwort vergessen" (wenn die Familie keinen eigenen SMTP hat)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional: maximale Upload-Größe in MB (Dokumente)
# MAX_UPLOAD_MB=25

# Optional: zusätzliche erlaubte Wurzelpfade für den Dokumentenspeicher (Komma-getrennt), z. B. ein gemountetes NAS
# DOCS_ALLOWED_ROOTS=/mnt/nas

# Optional: Server darf keine Adressen im lokalen Netz abrufen (iCal-Feeds, Wunschlisten-Vorschau)
# BLOCK_PRIVATE_URLS=false
